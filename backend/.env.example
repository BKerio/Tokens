# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# CORS - comma-separated list of allowed origins (use * for open access in dev)
CORS_ORIGIN=*

# Database (PostgreSQL). `?schema=` selects the Postgres schema TokenPap lives in.
# DATABASE_URL is used by the running app (pooler is fine); DIRECT_URL (optional)
# is used by Prisma migrate/db push and the Mongo import - DDL needs a session connection.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?schema=tokenpap&pgbouncer=true&connection_limit=5
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?schema=tokenpap

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Encrypts stored M-Pesa/SMS credentials at rest (defaults to JWT_SECRET if unset).
# Changing it makes previously saved gateway secrets unreadable.
# ENCRYPTION_KEY=

# Public URLs
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
# Uploaded vendor logos are written here and served at /uploads
UPLOAD_DIR=uploads

# Prism STS token vending (Thrift over TLS)
PRISM_TOKEN_HOST=pt-vend.prismcrypto.co.za
PRISM_TOKEN_PORT=9443
PRISM_TOKEN_USERNAME=
PRISM_TOKEN_PASSWORD=
PRISM_TOKEN_REALM=local
# The legacy client accepted self-signed certificates; set true to verify.
PRISM_TLS_VERIFY=false

# STS control-token mappings (blank index = that token type is disabled)
TOKEN_CONTROL_CLEAR_TAMPER_INDEX=
TOKEN_CONTROL_CLEAR_TAMPER_VALUE=1
TOKEN_CONTROL_CLEAR_TAMPER_IS_FLAG=true
TOKEN_CONTROL_CLEAR_CREDIT_INDEX=
TOKEN_CONTROL_CLEAR_CREDIT_VALUE=0
TOKEN_CONTROL_CLEAR_CREDIT_IS_FLAG=false
TOKEN_CONTROL_MAX_OVERDRAFT_INDEX=
TOKEN_CONTROL_MAX_OVERDRAFT_VALUE=
TOKEN_CONTROL_MAX_OVERDRAFT_IS_FLAG=false

# NCBA paybill webhook credentials (NCBA sends these in each notification)
NCBA_PAYBILL_USERNAME=
NCBA_PAYBILL_PASSWORD=
NCBA_PAYBILL_SHORTCODE=880100

# SMS fallbacks - used only when neither the vendor nor Settings → SMS has a value
# SMS_API_KEY=
# SMS_PARTNER_ID=
# SMS_SHORTCODE=
# SMS_API_URL=

# SMTP for password-reset emails (optional - reset by SMS works without it)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM="TokenPap <no-reply@tokenpap.com>"

# Google sign-in for customers (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Seed (npm run db:seed) - a random password is generated and printed if unset
# SEED_ADMIN_EMAIL=admin@tokenpap.com
# SEED_ADMIN_PASSWORD=
