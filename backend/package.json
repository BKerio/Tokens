{
  "name": "tokenpap-backend",
  "version": "2.0.0",
  "description": "TokenPap - prepaid utility token vending platform API (Fastify + PostgreSQL)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src/**/*.ts --ext ts --exec npx tsx src/server.ts",
    "build": "prisma generate && tsc && node -e \"require('fs').cpSync('src/generated', 'dist/generated', {recursive:true})\"",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:regions": "tsx prisma/seed-regions.ts",
    "migrate:mongo": "tsx scripts/migrate-from-mongo.ts",
    "prism:test": "tsx scripts/prism-test.ts",
    "postinstall": "prisma generate"
  },
  "keywords": [
    "prepaid",
    "sts",
    "token-vending",
    "mpesa",
    "fastify",
    "typescript"
  ],
  "author": "TokenPap",
  "license": "ISC",
  "type": "commonjs",
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.2.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcrypt": "^6.0.0",
    "fastify": "^5.4.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.17.0",
    "nodemailer": "^7.0.5",
    "pg": "^8.20.0",
    "pino": "^9.6.0",
    "prisma": "^7.8.0",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
